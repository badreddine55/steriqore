# Staging env template (S5-ANA-02). Copy to .env.staging (gitignored) and
# fill in every "CHANGE_ME" before deploying docker-compose.staging.yml —
# none of these have real values yet (no staging host/domain/Sentry
# project/S3 account exists, see docs/open-questions.md).

APP_NAME=SteriQore
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# The actual staging domain isn't decided yet — see docs/open-questions.md.
APP_URL=https://CHANGE_ME.staging.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=steriqore
DB_USERNAME=steriqore_app
DB_PASSWORD=CHANGE_ME
DB_ADMIN_USERNAME=saw
DB_ADMIN_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null

FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Real mail delivery in staging — Resend, not the local Mailpit catch-all.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=CHANGE_ME

# Self-hosted MinIO by default (same image as local dev, no external
# account needed) — swap for a managed S3 provider later if that becomes
# the production choice; nothing in the app code depends on which.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=steriqore-exports
AWS_BUCKET_MEDIA=steriqore-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# No Sentry project exists yet — leave blank until one does (S5-ANA-02).
SENTRY_LARAVEL_DSN=

RUN_MIGRATIONS=true
RUN_SCHEDULER=true
OCTANE_WORKERS=auto
