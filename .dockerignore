# Version control
.git
.gitignore
.gitattributes

# Dependencies (rebuilt inside Docker)
node_modules
vendor

# Environment files (injected at runtime)
.env
.env.local
.env.*.local
.env.coolify

# IDE / Editor
.cursor
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

