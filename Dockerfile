FROM composer:2 AS deps

WORKDIR /app

COPY composer.json composer.lock ./
# composer:2 lacks ext-pcntl/posix (Horizon), ext-exif (medialibrary's
# spatie/image, for reading photo orientation), and ext-bcmath/ext-gd
# (tc-lib-barcode, for DataMatrix generation) — all exist in the runtime
# image. Its own bundled PHP (8.5) is also newer than the runtime's 8.4
# (CLAUDE.md's stack), which trips phpoffice/phpspreadsheet's <8.5 cap —
# this stage only resolves/downloads packages, it never executes
# application code, so the actual runtime PHP version is what matters.
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction \
    --ignore-platform-req=php \
    --ignore-platform-req=ext-pcntl \
    --ignore-platform-req=ext-posix \
    --ignore-platform-req=ext-exif \
    --ignore-platform-req=ext-bcmath \
    --ignore-platform-req=ext-gd

COPY . .
RUN composer dump-autoload --optimize --no-dev
RUN php artisan wayfinder:generate --with-form 2>/dev/null || true


FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.ts tsconfig.json ./
COPY resources ./resources
COPY public ./public

# Overwrite Wayfinder types with freshly generated ones from deps stage
COPY --from=deps /app/resources/js/actions ./resources/js/actions
COPY --from=deps /app/resources/js/routes ./resources/js/routes
# Copy Wayfinder runtime helper directory (gitignored, generated by wayfinder:generate)
COPY --from=deps /app/resources/js/wayfinder ./resources/js/wayfinder

# Wayfinder Vite plugin shim
RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/php && chmod +x /usr/local/bin/php

RUN NODE_OPTIONS=--dns-result-order=ipv4first npm run build

# ============================================================================
# Stage 3: Production Runtime (Using Base Image)
# ============================================================================
FROM nexudev/laravel-octane-frankenphp:base AS production

WORKDIR /app

# Performance Tuning — Configurable Workers
# Default to "auto" (CPU cores). To scale up, pass e.g. -e OCTANE_WORKERS=256 at runtime.
ENV OCTANE_WORKERS=auto

# Standard Production Env
ENV APP_ENV=production \
    APP_DEBUG=false \
    OCTANE_SERVER=frankenphp \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=info

# Node.js + Chromium for spatie/browsershot (label PDF sheets, S3-ANA-04).
# The base image ships neither. Chromium comes from apt, not Puppeteer's own
# download, so puppeteer only needs to be told where to find it
# (PUPPETEER_SKIP_CHROMIUM_DOWNLOAD) rather than fetching its own copy.
# Installed to /opt/browsershot, not /app — this app's own package.json
# (frontend deps) is COPY'd into /app later in this stage and would
# otherwise collide with the one `npm install` creates here.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    LARAVEL_PDF_CHROME_PATH=/usr/bin/chromium \
    LARAVEL_PDF_NO_SANDBOX=true \
    LARAVEL_PDF_NODE_MODULES_PATH=/opt/browsershot/node_modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-liberation ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install --prefix /opt/browsershot puppeteer \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# postgresql-client-18 for spatie/laravel-backup's pg_dump (S5-ANA-03) —
# matching major version, not whatever Debian bookworm's default repo
# ships (older), via the official PGDG apt repository.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-common \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get update && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# Optimized PHP Configuration
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.memory_consumption=512'; \
    echo 'opcache.interned_strings_buffer=64'; \
    echo 'opcache.max_accelerated_files=32531'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.jit=tracing'; \
    echo 'opcache.jit_buffer_size=128M'; \
    echo 'realpath_cache_size=4096K'; \
    echo 'realpath_cache_ttl=600'; \
    } > /usr/local/etc/php/conf.d/performance.ini

# Copy application source code first
COPY . .

# Overlay build artifacts on top — ensures stage outputs always win over local files
COPY --from=deps /app/vendor ./vendor
COPY --from=frontend /app/public/build ./public/build
COPY --from=frontend /app/resources/js/wayfinder ./resources/js/wayfinder

# Final cleanup and optimization
RUN php artisan config:cache && \
    php artisan route:cache && \
    php artisan view:cache

# ─── Permissions ──────────────────────────────────────────────────────
RUN mkdir -p \
    storage/logs \
    storage/framework/cache/data \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache \
    && chown -R www-data:www-data \
    storage \
    bootstrap/cache \
    && chmod -R 775 \
    storage \
    bootstrap/cache

# ─── Supervisor configuration ────────────────────────────────────────
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# ─── Entrypoint ──────────────────────────────────────────────────────
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=15s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8000/up || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
