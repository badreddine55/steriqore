APP_NAME=SteriQore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5455
DB_DATABASE=saw
# Restricted, non-superuser role — RLS only applies for a non-superuser,
# non-owner connection. See docker/postgres/init/01-create-app-role.sql.
DB_USERNAME=steriqore_app
DB_PASSWORD=steriqore_app_secret
# Elevated connection, migrations only.
DB_ADMIN_USERNAME=saw
DB_ADMIN_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# no-reply@<APP_DOMAIN> once the TLD is decided — see docs/open-questions.md
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=resend in staging/production; get the key from Resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_BUCKET_MEDIA=steriqore-media

# Blank = Sentry SDK no-ops silently (dev/test default). Set in
# staging/production once a Sentry project exists — see
# docs/open-questions.md (S5-ANA-02).
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
